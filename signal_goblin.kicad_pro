(kicad_pro
  (version 1)
  (defaults
    (board_setup
      (stackup
        (layer "F.Cu" (type "copper") (color ""))
        (layer "B.Cu" (type "copper") (color ""))
      )
    )
  )
  (meta
    (filename "signal_goblin.kicad_pro")
  )
  (net_settings
    (classes
      (net_class "Default"
        (clearance 0.2)
        (track_width 0.25)
        (via_dia 0.8)
        (via_drill 0.4)
        (uvia_dia 0.3)
        (uvia_drill 0.1)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
      )
      (net_class "Power"
        (clearance 0.3)
        (track_width 0.5)
        (via_dia 1.0)
        (via_drill 0.5)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
        (nets "VCC" "GND" "3V3" "BATT+")
      )
      (net_class "SPI"
        (clearance 0.2)
        (track_width 0.3)
        (via_dia 0.8)
        (via_drill 0.4)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
        (nets "SPI_SCK" "SPI_MISO" "SPI_MOSI")
      )
    )
  )
  (schematic
    (legacy_lib_dir "")
    (legacy_lib_list)
  )
  (boards)
  (cvpcb
    (equivalence_files)
  )
  (libraries
    (pinned_symbol_libs)
    (pinned_footprint_libs)
  )
  (erc
    (severities)
  )
)
